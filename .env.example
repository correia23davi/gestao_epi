# ─────────────────────────────────────────────────────────────────
# Segredos da aplicação — copie este arquivo para ".env" e preencha.
# NUNCA cometa o arquivo ".env" real no git (o .gitignore já protege isso).
# Gere valores aleatórios com: npm run gen-secrets
# ─────────────────────────────────────────────────────────────────

# Chave usada para assinar os tokens de sessão (JWT).
JWT_SECRET=

# Chave AES-256 (32 bytes em hexadecimal = 64 caracteres) usada para cifrar
# os dados pessoais dos colaboradores (nome, idade, área, cargo, assinatura
# e o histórico de retiradas). Sem essa chave nenhum dado pessoal pode ser
# lido do banco, mesmo por quem tem acesso direto ao banco de dados.
DATA_ENCRYPTION_KEY=

# Credenciais do administrador criado automaticamente no primeiro uso do
# sistema. Troque a senha padrão assim que possível pela própria interface.
SEED_ADMIN_NAME=ADMIN
SEED_ADMIN_LOGIN=admin
SEED_ADMIN_PASSWORD=admin123

# Opcional — preenche o sistema com colaboradores e retiradas de exemplo.
# Use apenas em ambiente de demonstração/testes.
SEED_DEMO_DATA=false

# Redis (Upstash), necessário para persistir dados quando publicado na Vercel.
# Instale a integração "Upstash for Redis" pela aba Storage/Marketplace do seu
# projeto na Vercel — as duas variáveis abaixo são preenchidas automaticamente.
# Em desenvolvimento local, se ficarem vazias, o sistema usa um arquivo JSON
# local em ".data/" apenas para você conseguir testar sem configurar nada.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
